<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }} — {{ site.tagline }}{% endif %}</title>
<meta name="description" content="{{ description or summary or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">

<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }} — {{ site.tagline }}{% endif %}">
<meta property="og:description" content="{{ description or summary or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ photo or '/assets/img/hw-ip-profile.png' }}">
<meta property="og:image:width" content="{{ '1200' if photo else '1000' }}">
<meta property="og:image:height" content="{{ '630' if photo else '1000' }}">
<meta property="og:image:alt" content="{{ photoAlt or 'The hw.i.p mark: a single unbroken white stroke on a dark green tile.' }}">
<meta name="twitter:card" content="summary_large_image">

<meta name="theme-color" content="#0F4D33">
<link rel="icon" href="/assets/img/logo-tile-green.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/hw-ip-profile.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap">

<link rel="stylesheet" href="/assets/css/colors.css">
<link rel="stylesheet" href="/assets/css/typography.css">
<link rel="stylesheet" href="/assets/css/spacing.css">
<link rel="stylesheet" href="/assets/css/effects.css">
<link rel="stylesheet" href="/assets/css/base.css">
<link rel="stylesheet" href="/assets/css/site.css">

<script type="application/ld+json">
{% if ogType == "article" %}
{
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": {{ title | dump | safe }},
  "description": {{ (summary or description or site.description) | dump | safe }},
  "url": "{{ site.url }}{{ page.url }}",
  {% if photo %}"image": "{{ site.url }}{{ photo }}",{% endif %}
  {% if repo %}"codeRepository": {{ repo | dump | safe }},{% endif %}
  "creator": { "@type": "Person", "name": "hw.i.p", "url": "{{ site.url }}" }
}
{% else %}
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "{{ site.name }}",
  "description": {{ site.description | dump | safe }},
  "url": "{{ site.url }}"
}
{% endif %}
</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
{% include "partials/header.njk" %}
<hr class="rule">
<main id="main">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
</body>
</html>
